# ╔══════════════════════════════════════════════════════════════╗
# ║  GRT System — Environment Template                          ║
# ║  Copy this file to .env.development / .env.test / .env      ║
# ║  and fill in your actual credentials.                       ║
# ║  NEVER commit real credentials to version control.          ║
# ╚══════════════════════════════════════════════════════════════╝

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/grt_dev_db

# ── Authentication ──────────────────────────────────────────────
LOCAL_AUTH=true
VITE_LOCAL_AUTH=true
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ── AI Provider (openai | ollama | deepseek) ───────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OPENAI_API_KEY=sk-your-key
# DEEPSEEK_API_KEY=your-key

# ── Region (US | DE | CN) ──────────────────────────────────────
APP_REGION=CN

# ── Jiandaoyun ──────────────────────────────────────────────────
JIANDAOYUN_API_KEY=
JIANDAOYUN_CORP_ID=

# ── DingTalk Webhook ─────────────────────────────────────────────
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=

# ── JDY User Provisioning ───────────────────────────────────────
JDY_DEFAULT_PASSWORD=

# ── Security ──────────────────────────────────────────────────
ENCRYPTION_MASTER_KEY=change-me-to-a-random-64-char-hex-string

# ── AI Providers Extended ─────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
LLM_API_URL=
LLM_API_KEY=
OFFLINE_MODE=false

# ── Microsoft Graph ───────────────────────────────────────────
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Email (SMTP/SendGrid) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Webhooks ──────────────────────────────────────────────────
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# ── GitHub CI/CD ──────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ── Gateway ───────────────────────────────────────────────────
GATEWAY_ENFORCE=false

# ── Frontend ────────────────────────────────────────────────────
VITE_APP_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_OAUTH_PORTAL_URL=
VITE_API_URL=/api
