# ╔══════════════════════════════════════════════════════════════╗
# ║  GRT System — Environment Template                          ║
# ║  Copy this file to .env.development / .env.test / .env      ║
# ║  and fill in your actual credentials.                       ║
# ║  NEVER commit real credentials to version control.          ║
# ╚══════════════════════════════════════════════════════════════╝

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/grt_dev_db

# ── Authentication ──────────────────────────────────────────────
LOCAL_AUTH=true
VITE_LOCAL_AUTH=true
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ── AI Provider (openai | ollama | deepseek) ───────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OPENAI_API_KEY=sk-your-key
# DEEPSEEK_API_KEY=your-key

# ── Region (US | DE | CN) ──────────────────────────────────────
APP_REGION=CN

# ── Jiandaoyun ──────────────────────────────────────────────────
JIANDAOYUN_API_KEY=
JIANDAOYUN_CORP_ID=

# ── Frontend ────────────────────────────────────────────────────
VITE_APP_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
