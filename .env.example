# ╔══════════════════════════════════════════════════════════════╗
# ║  GRT System — Environment Template                          ║
# ║  Copy this file to .env.development / .env.test / .env      ║
# ║  and fill in your actual credentials.                       ║
# ║  NEVER commit real credentials to version control.          ║
# ╚══════════════════════════════════════════════════════════════╝

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/grt_dev_db
# POSTGRES_PASSWORD is used by docker-compose for the PostgreSQL container
POSTGRES_PASSWORD=grt_password

# ── Authentication ──────────────────────────────────────────────
LOCAL_AUTH=true
VITE_LOCAL_AUTH=true
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ── OAuth (optional, for SSO) ──────────────────────────────────
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# ── Built-in Forge API (optional) ─────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── AI Provider (openai | ollama | deepseek) ───────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OPENAI_API_KEY=sk-your-key
# DEEPSEEK_API_KEY=your-key

# ── Region (US | DE | CN) ──────────────────────────────────────
APP_REGION=CN

# ── External Sync ──────────────────────────────────────────────────
EXT_SYNC_API_KEY=
EXT_SYNC_CORP_ID=

# ── DingTalk Webhook ─────────────────────────────────────────────
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=

# ── JDY User Provisioning ───────────────────────────────────────
JDY_DEFAULT_PASSWORD=

# ── Security ──────────────────────────────────────────────────
ENCRYPTION_MASTER_KEY=change-me-to-a-random-64-char-hex-string
LICENSE_SECRET=change-me-to-a-random-string
SYNC_SECRET_KEY=change-me-to-a-random-string

# ── AI Providers Extended ─────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=
LLM_API_URL=
LLM_API_KEY=
OFFLINE_MODE=false

# ── Microsoft Graph ───────────────────────────────────────────
# Required Azure AD permissions:
#   Calendars.Read, Chat.Read, Chat.ReadWrite (existing)
#   Mail.Read, Mail.Send (for Outlook Mail integration)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Email (SMTP/SendGrid) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Webhooks ──────────────────────────────────────────────────
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# ── GitHub CI/CD ──────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ── NemoClaw (AI Claw Agent Framework) ─────────────────────────
# NemoClaw is the internal AI agent execution engine
# These settings control agent behavior and security sandbox
NEMOCLAW_MAX_CONCURRENT_AGENTS=5
NEMOCLAW_TASK_TIMEOUT_MS=120000
NEMOCLAW_SANDBOX_LEVEL=L2
# L1=日志only, L2=SQL白名单, L3=完全沙箱, L4=隔离容器

# ── Gateway ───────────────────────────────────────────────────
GATEWAY_ENFORCE=false

# ── Frontend ────────────────────────────────────────────────────
VITE_APP_ID=
VITE_APP_TITLE=GRT智能系统
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_API_URL=/api
