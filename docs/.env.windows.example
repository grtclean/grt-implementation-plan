# ============================================================
# GRT智能系统 Windows本地部署环境变量配置模板
# 版本: 1.0
# 日期: 2026-01-24
# 说明: 复制此文件为 .env 并填写实际值
# ============================================================

# ============================================================
# 必需配置 - 系统无法启动如果缺少这些配置
# ============================================================

# 数据库连接字符串
# 格式: mysql://用户名:密码@主机:端口/数据库名
# Windows本地MySQL示例:
DATABASE_URL=mysql://root:your_password@localhost:3306/grt_system

# JWT签名密钥 - 用于用户会话加密
# 要求: 至少32个字符的随机字符串
# 生成方法: 在PowerShell中运行 [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_change_this

# 运行环境
# 可选值: development | production
NODE_ENV=development

# ============================================================
# 应用配置
# ============================================================

# 应用端口 (默认3000)
PORT=3000

# 应用标题 (显示在浏览器标签页)
VITE_APP_TITLE=GRT智能系统

# 应用Logo URL (可选)
VITE_APP_LOGO=

# ============================================================
# OAuth认证配置 (如果使用Manus OAuth)
# ============================================================

# Manus OAuth 应用ID
VITE_APP_ID=your_manus_app_id

# Manus OAuth 服务器地址
OAUTH_SERVER_URL=https://api.manus.im

# Manus OAuth 登录门户地址
VITE_OAUTH_PORTAL_URL=https://manus.im/oauth

# 应用所有者信息 (OAuth回调后填充)
OWNER_OPEN_ID=
OWNER_NAME=

# ============================================================
# Microsoft Graph API配置 (用于邮件通知)
# 获取方式: Azure Portal -> App registrations
# ============================================================

# Azure AD 应用客户端ID
MICROSOFT_CLIENT_ID=

# Azure AD 应用客户端密钥
MICROSOFT_CLIENT_SECRET=

# Azure AD 租户ID
MICROSOFT_TENANT_ID=

# ============================================================
# AI服务配置
# ============================================================

# Google Gemini API密钥
# 获取方式: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Manus内置AI服务 (如果使用Manus平台)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# ============================================================
# 简道云集成配置 (如果需要数据同步)
# ============================================================

# 简道云API密钥
JIANDAOYUN_API_KEY=

# 简道云企业ID
JIANDAOYUN_CORP_ID=

# ============================================================
# 文件存储配置 (S3兼容)
# ============================================================

# S3存储桶名称
S3_BUCKET=

# S3区域
S3_REGION=

# S3访问密钥ID
S3_ACCESS_KEY_ID=

# S3访问密钥
S3_SECRET_ACCESS_KEY=

# S3端点 (如果使用非AWS S3兼容服务)
S3_ENDPOINT=

# ============================================================
# 分析和监控配置 (可选)
# ============================================================

# 分析服务端点
VITE_ANALYTICS_ENDPOINT=

# 网站分析ID
VITE_ANALYTICS_WEBSITE_ID=

# ============================================================
# 开发调试配置
# ============================================================

# 启用调试日志 (development环境自动启用)
DEBUG=false

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# ============================================================
# 安全配置
# ============================================================

# CORS允许的源 (生产环境必须配置)
# 多个源用逗号分隔
CORS_ORIGINS=http://localhost:3000

# Cookie安全设置 (生产环境设为true)
COOKIE_SECURE=false

# Cookie同站策略: strict | lax | none
COOKIE_SAME_SITE=lax

# ============================================================
# 配置说明
# ============================================================
#
# 1. 必需配置项必须填写，否则系统无法启动
# 2. 可选配置项如果不需要可以留空或删除
# 3. 生产环境部署时请确保:
#    - JWT_SECRET 使用强随机字符串
#    - DATABASE_URL 使用专用数据库用户
#    - COOKIE_SECURE 设为 true
#    - CORS_ORIGINS 设为实际域名
# 4. 敏感信息不要提交到版本控制系统
#
# ============================================================
