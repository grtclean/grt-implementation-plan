# GRT智能系统 - Windows 11本地开发环境配置
# 复制此文件为 .env.local 并填入您的配置值

# ============================================
# 数据库配置
# ============================================
# MySQL/TiDB连接字符串
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://root:password@localhost:3306/grt_dev

# ============================================
# OAuth认证配置
# ============================================
# OAuth应用ID（从Manus平台获取）
VITE_APP_ID=your_app_id_here

# OAuth门户URL（Manus OAuth服务地址）
VITE_OAUTH_PORTAL_URL=https://api.manus.im

# OAuth服务器URL（后端API基础URL）
OAUTH_SERVER_URL=https://api.manus.im

# ============================================
# JWT和会话配置
# ============================================
# JWT签名密钥（用于会话加密）
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# ============================================
# 应用配置
# ============================================
# 应用标题
VITE_APP_TITLE=GRT智能系统快速实施方案

# 应用Logo URL
VITE_APP_LOGO=https://your-cdn.com/logo.png

# ============================================
# Manus内置API配置
# ============================================
# Manus内置API基础URL
BUILT_IN_FORGE_API_URL=https://api.manus.im

# Manus内置API密钥（服务端）
BUILT_IN_FORGE_API_KEY=your_forge_api_key_here

# Manus内置API密钥（前端）
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_api_key_here

# Manus内置API URL（前端）
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im

# ============================================
# 分析和监控配置
# ============================================
# 分析端点URL
VITE_ANALYTICS_ENDPOINT=https://analytics.manus.im

# 分析网站ID
VITE_ANALYTICS_WEBSITE_ID=your_website_id_here

# ============================================
# 所有者信息
# ============================================
# 所有者名称
OWNER_NAME=Your Name

# 所有者Open ID
OWNER_OPEN_ID=your_open_id_here

# ============================================
# 开发环境特定配置
# ============================================
# Node环境
NODE_ENV=development

# Vite开发服务器主机
VITE_DEV_SERVER_HOST=localhost

# Vite开发服务器端口
VITE_DEV_SERVER_PORT=3000

# WebSocket HMR配置（热模块替换）
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws
