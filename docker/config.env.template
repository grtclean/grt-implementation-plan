# ============================================
# GRT智能系统 环境配置模板
# 版本: v2.6.2
# ============================================
# 使用说明:
# 1. 复制此文件为 config.env
# 2. 根据部署环境修改配置值
# 3. 敏感信息请使用密钥管理服务
# ============================================

# ============================================
# 基础环境配置
# ============================================
NODE_ENV=production
VERSION=2.6.2

# 部署模式: local | cloud | hybrid
DEPLOYMENT_MODE=cloud

# 区域配置: asia | europe | americas
DEPLOYMENT_REGION=asia

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=mysql://user:password@host:3306/grt_db
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT_MS=30000

# 数据库读写分离 (可选)
DATABASE_READ_URL=
DATABASE_WRITE_URL=

# ============================================
# Redis 缓存配置
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# S3兼容存储配置
# ============================================
# 存储提供商: aws_s3 | aliyun_oss | minio | local_fs
STORAGE_PROVIDER=aws_s3

# S3配置
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=grt-production
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=ap-northeast-1

# 本地存储路径 (仅 STORAGE_PROVIDER=local_fs 时使用)
LOCAL_STORAGE_PATH=/data/grt/attachments
LOCAL_BACKUP_PATH=/data/grt/backups

# ============================================
# 全球网关配置
# ============================================
GLOBAL_GATEWAY_URL=https://gateway.gerrytech.com
GATEWAY_REGION=asia
GATEWAY_TIMEOUT_MS=10000

# 区域端点
GATEWAY_ASIA_URL=https://asia.gateway.gerrytech.com
GATEWAY_EUROPE_URL=https://eu.gateway.gerrytech.com
GATEWAY_AMERICAS_URL=https://us.gateway.gerrytech.com

# ============================================
# 多租户配置
# ============================================
DEFAULT_ORGANIZATION_ID=grt-headquarters

# 租户隔离模式: strict | shared | hybrid
TENANT_ISOLATION_MODE=strict

# RAG向量索引隔离
RAG_ISOLATION_ENABLED=true

# ============================================
# AI服务配置
# ============================================
AI_SERVICE_ENDPOINT=${AI_SERVICE_ENDPOINT}
AI_DEFAULT_LANGUAGE=zh-CN
AI_SUPPORTED_LANGUAGES=zh-CN,en-US,de-DE

# AI模型配置
AI_MODEL_NAME=gpt-4
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ============================================
# 认证与安全配置
# ============================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=86400

# OAuth配置
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# ============================================
# 多时区配置
# ============================================
# 默认时区 (所有数据以UTC存储)
DEFAULT_TIMEZONE=UTC

# 支持的时区列表
SUPPORTED_TIMEZONES=Asia/Shanghai,Europe/Berlin,America/New_York,Asia/Tokyo

# ============================================
# 多币种配置
# ============================================
DEFAULT_CURRENCY=CNY
SUPPORTED_CURRENCIES=CNY,EUR,USD,GBP,JPY

# 汇率更新来源: manual | api | bank
EXCHANGE_RATE_SOURCE=manual

# 汇率API配置 (如使用API更新)
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_API_KEY=

# ============================================
# 健康检查配置
# ============================================
HEALTH_CHECK_INTERVAL=300
HEALTH_CHECK_TIMEOUT=30

# 告警阈值
ALERT_CPU_THRESHOLD=70
ALERT_MEMORY_THRESHOLD=80
ALERT_DISK_THRESHOLD=85
ALERT_API_LATENCY_MS=500

# 告警通知
ALERT_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=

# ============================================
# 迁移配置
# ============================================
MIGRATION_ENABLED=true
MIGRATION_AUTO_EXPORT_THRESHOLD=70

# 迁移目标环境
MIGRATION_TARGET_ENVIRONMENT=cloud
MIGRATION_TARGET_DATABASE_URL=
MIGRATION_TARGET_S3_BUCKET=

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=file

# 日志文件路径
LOG_FILE_PATH=/app/logs/grt.log
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10

# ============================================
# API配置
# ============================================
API_PORT=3000
API_REPLICAS=1
API_RATE_LIMIT=1000
API_TIMEOUT_MS=30000

# CORS配置
CORS_ORIGINS=https://app.gerrytech.com,https://admin.gerrytech.com

# ============================================
# 监控配置 (可选)
# ============================================
# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=false
GRAFANA_PORT=3001

# ============================================
# 邮件配置
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@gerrytech.com

# ============================================
# 第三方集成
# ============================================
# 简道云
JIANDAOYUN_API_KEY=
JIANDAOYUN_CORP_ID=

# Microsoft 365
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
