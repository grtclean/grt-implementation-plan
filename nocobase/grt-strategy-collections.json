        },
        {
          "name": "customer_timezone",
          "type": "string",
          "title": "客户时区",
          "description": "用于时差提醒"
        },
        {
          "name": "is_working_hours",
          "type": "boolean",
          "title": "当前是否为客户工作时间",
          "description": "自动计算，用于高亮显示"
        },
        {
          "name": "description",
          "type": "text",
          "title": "任务描述"
        },
        {
          "name": "solution_draft",
          "type": "text",
