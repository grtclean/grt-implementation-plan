{
  "collections": [
    {
      "name": "Strategy_Master_Plan",
      "title": "战略总体规划",
      "description": "GRT 2028/2030全球战略规划指标库",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "primaryKey": true,
          "autoIncrement": false,
          "title": "记录ID"
        },
        {
          "name": "year",
          "type": "integer",
          "title": "规划年份",
          "description": "2026, 2028, 2030",
          "required": true,
          "uiSchema": {
            "type": "number",
            "enum": [2026, 2028, 2030]
          }
        },
        {
          "name": "region",
          "type": "string",
          "title": "地区",
          "description": "Global, Asia, Europe, US",
          "required": true,
          "uiSchema": {
            "type": "select",
            "enum": ["Global", "Asia", "Europe", "US"]
          }
        },
        {
          "name": "metric",
          "type": "string",
          "title": "指标类型",
          "description": "Revenue(销售额) / Headcount(人数)",
          "required": true,
          "uiSchema": {
            "type": "select",
            "enum": ["Revenue", "Headcount", "Market_Share", "Customer_Satisfaction"]
          }
        },
        {
          "name": "target_value",
          "type": "number",
          "title": "目标值",
          "description": "例如: 300000000 (3亿RMB)",
          "required": true
        },
        {
          "name": "actual_value",
          "type": "number",
          "title": "实际值",
          "description": "当前实现的数值"
        },
        {
          "name": "unit",
          "type": "string",
          "title": "单位",
          "description": "CNY, EUR, USD, Person",
          "required": true,
          "uiSchema": {
            "type": "select",
            "enum": ["CNY", "EUR", "USD", "Person"]
          }
        },
        {
          "name": "achievement_rate",
          "type": "number",
          "title": "达成率(%)",
          "description": "自动计算: actual_value / target_value * 100",
          "formula": "actual_value / target_value * 100"
        },
        {
          "name": "status",
          "type": "string",
          "title": "状态",
          "description": "On_Track / At_Risk / Off_Track",
          "uiSchema": {
            "type": "select",
            "enum": ["On_Track", "At_Risk", "Off_Track"]
          }
        },
        {
          "name": "notes",
          "type": "text",
          "title": "备注"
        },
        {
          "name": "created_at",
          "type": "date",
          "title": "创建时间",
          "defaultValue": "now()"
        },
        {
          "name": "updated_at",
          "type": "date",
          "title": "更新时间",
          "defaultValue": "now()"
        }
      ]
    },
    {
      "name": "Resource_Allocation",
      "title": "资源编制表",
      "description": "动态的部门和角色编制，基于战略目标自动触发",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "primaryKey": true,
          "title": "编制ID"
        },
        {
          "name": "department",
          "type": "string",
          "title": "部门",
          "description": "Sales / Service / ISC / PMO / HRM / Finance",
          "required": true,
          "uiSchema": {
            "type": "select",
            "enum": ["Sales", "Service", "ISC", "PMO", "HRM", "Finance"]
          }
        },
        {
          "name": "region",
          "type": "string",
          "title": "地区",
          "required": true,
          "uiSchema": {
            "type": "select",
            "enum": ["Asia", "Europe", "US", "Global"]
          }
        },
        {
          "name": "role",
          "type": "string",
          "title": "职位",
          "description": "例如: Europe Tech Sales, Asia Remote Support",
          "required": true
        },
        {
          "name": "planned_headcount",
          "type": "integer",
          "title": "计划人数",
          "required": true
        },
        {
          "name": "current_headcount",
          "type": "integer",
          "title": "当前人数"
        },
        {
          "name": "gap",
          "type": "integer",
          "title": "缺口",
          "formula": "planned_headcount - current_headcount"
        },
        {
          "name": "trigger_condition",
          "type": "text",
          "title": "触发条件",
          "description": "例如: Europe Revenue > 6M EUR",
          "required": true
        },
        {
          "name": "trigger_status",
          "type": "string",
          "title": "触发状态",
          "description": "Pending / Triggered / Completed",
          "uiSchema": {
            "type": "select",
            "enum": ["Pending", "Triggered", "Completed"]
          }
        },
        {
          "name": "recruitment_request_id",
          "type": "string",
          "title": "关联招聘需求ID",
          "description": "自动关联到HRM_Recruitment表"
        },
        {
          "name": "priority",
          "type": "string",
          "title": "优先级",
          "uiSchema": {
            "type": "select",
            "enum": ["Critical", "High", "Medium", "Low"]
          }
        },
        {
          "name": "notes",
          "type": "text",
          "title": "备注"
        }
      ]
    },
    {
      "name": "Global_Sales_Opportunities",
      "title": "全球销售机会",
      "description": "针对欧美少人多产模式的特化CRM",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "primaryKey": true,
          "title": "商机ID"
        },
        {
          "name": "customer_name",
          "type": "string",
          "title": "客户名称",
          "required": true
        },
        {
          "name": "region",
          "type": "string",
          "title": "地区",
          "required": true,
          "uiSchema": {
            "type": "select",
            "enum": ["Europe", "US", "Asia", "Other"]
          }
        },
        {
          "name": "potential_value",
          "type": "number",
          "title": "潜在价值(USD)",
          "required": true
        },
        {
          "name": "currency",
          "type": "string",
          "title": "货币",
          "uiSchema": {
            "type": "select",
            "enum": ["USD", "EUR", "CNY"]
          }
        },
        {
          "name": "stage",
          "type": "string",
          "title": "阶段",
          "description": "Prospect / Qualified / Proposal / Negotiation / Won / Lost",
          "uiSchema": {
            "type": "select",
            "enum": ["Prospect", "Qualified", "Proposal", "Negotiation", "Won", "Lost"]
          }
        },
        {
          "name": "sales_rep",
          "type": "string",
          "title": "销售代表",
          "required": true
        },
        {
          "name": "isc_support_required",
          "type": "boolean",
          "title": "是否需要ISC支持",
          "description": ">$1M的商机必须关联ISC技术支持"
        },
        {
          "name": "isc_ticket_id",
          "type": "string",
          "title": "ISC工单ID",
          "description": "当potential_value > 1000000时为必填"
        },
        {
          "name": "expected_close_date",
          "type": "date",
          "title": "预期成交日期"
        },
        {
          "name": "probability",
          "type": "number",
          "title": "成功概率(%)",
          "uiSchema": {
            "type": "number",
            "min": 0,
            "max": 100
          }
        },
        {
          "name": "weighted_value",
          "type": "number",
          "title": "加权价值",
          "formula": "potential_value * probability / 100"
        },
        {
          "name": "notes",
          "type": "text",
          "title": "备注"
        },
        {
          "name": "created_at",
          "type": "date",
          "title": "创建时间",
          "defaultValue": "now()"
        }
      ]
    },
    {
