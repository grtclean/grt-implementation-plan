# GRT智能系统 - Docker环境变量模板
# 复制此文件为 .env 并填写实际值

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=grt_db
MYSQL_USER=grt_user
MYSQL_PASSWORD=your_user_password_here
DATABASE_URL=mysql://grt_user:your_user_password_here@mysql:3306/grt_db

# ==================== 应用配置 ====================
NODE_ENV=production
PORT=3000

# JWT密钥（至少32字符的随机字符串）
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# ==================== OAuth配置 ====================
VITE_APP_ID=your_app_id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im/login

# ==================== 所有者信息 ====================
OWNER_OPEN_ID=your_owner_open_id
OWNER_NAME=your_owner_name

# ==================== API配置 ====================
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=your_forge_api_key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_api_key

# ==================== 第三方服务 ====================
# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# 简道云API
JIANDAOYUN_API_KEY=your_jiandaoyun_api_key
JIANDAOYUN_CORP_ID=your_jiandaoyun_corp_id

# Microsoft Graph API
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_microsoft_tenant_id

# ==================== 分析配置 ====================
VITE_ANALYTICS_ENDPOINT=your_analytics_endpoint
VITE_ANALYTICS_WEBSITE_ID=your_website_id

# ==================== 应用信息 ====================
VITE_APP_TITLE=GRT智能系统
VITE_APP_LOGO=/logo.svg
