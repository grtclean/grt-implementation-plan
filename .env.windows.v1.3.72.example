# ==========================================
# GRT智能系统 v1.3.72 Windows 11 环境变量配置模板
# ==========================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改各项配置
# 3. 确保敏感信息（密码、密钥）已正确设置
# ==========================================

# ==========================================
# 数据库配置（必需）
# ==========================================
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 本地MySQL连接（非Docker）
DATABASE_URL=mysql://grt_user:YourSecurePassword123!@localhost:3306/grt_system

# ==========================================
# 应用配置（必需）
# ==========================================
# 运行环境：development（开发）或 production（生产）
NODE_ENV=production

# 服务端口
PORT=3000

# JWT密钥（用于会话加密，请使用以下命令生成）
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-character-hex-string-here

# ==========================================
# 应用信息（必需）
# ==========================================
VITE_APP_ID=grt-system-local
VITE_APP_TITLE=GRT智能系统
VITE_APP_LOGO=/logo.svg

# ==========================================
# OAuth配置（本地开发模式可留空）
# ==========================================
# 如需使用Manus OAuth认证，请配置以下变量
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=
# OWNER_NAME=

# ==========================================
# AI服务配置（推荐）
# ==========================================
# Gemini API（用于系统内置AI分析功能）
# 获取地址：https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# Microsoft Graph API（可选，日历同步功能）
# ==========================================
# Azure AD应用配置
# 获取地址：https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret

# ==========================================
# 简道云API（可选，数据同步功能）
# ==========================================
# 获取地址：简道云管理后台 > 开放平台 > API密钥
JIANDAOYUN_API_KEY=your-jiandaoyun-api-key
JIANDAOYUN_CORP_ID=your-corp-id

# ==========================================
# 通知服务配置（可选）
# ==========================================
# 钉钉机器人Webhook
# 获取方式：钉钉群 > 群设置 > 智能群助手 > 添加机器人
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET=your-dingtalk-secret

# 企业微信机器人Webhook
# 获取方式：企业微信群 > 群设置 > 群机器人 > 添加机器人
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 飞书机器人Webhook
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ==========================================
# S3存储配置（可选，文件上传功能）
# ==========================================
# AWS S3或兼容服务配置
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-northeast-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# ==========================================
# Redis配置（可选，缓存和会话存储）
# ==========================================
# REDIS_URL=redis://localhost:6379

# ==========================================
# 时区配置
# ==========================================
TZ=Asia/Shanghai

# ==========================================
# 开发调试配置（仅开发环境）
# ==========================================
# 启用详细日志
# DEBUG=true
# 启用SQL日志
# LOG_SQL=true
